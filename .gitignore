# macOS
.DS_Store

# Xcode — 用户级状态（每个开发者不同，不入库）
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Xcode — 构建产物
build/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM
